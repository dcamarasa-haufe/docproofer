{
  "name": "docproofer",
  "version": "1.0.0",
  "description": "Document proofer API built with Express, Vite and TypeScript",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx/esm src/index.ts",
    "build": "vite build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcamarasa-haufe/docproofer.git"
  },
  "keywords": [
    "express",
    "typescript",
    "vite",
    "api",
    "crud"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dcamarasa-haufe/docproofer/issues"
  },
  "homepage": "https://github.com/dcamarasa-haufe/docproofer#readme",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
